# Mobile Tyre Champions – Independent CRM & Admin Dashboard
# Environment Configuration Template

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mtc_crm

# Authentication & Session Security (Minimum 32 characters random secret)
SESSION_SECRET=replace-with-a-secure-random-32-character-secret-key-for-jwt-cookies

# Dedicated AES-256 Encryption Key for MFA Secrets (64 hex characters / 32 bytes)
MFA_ENCRYPTION_KEY=replace-with-a-secure-random-64-character-hex-encryption-key

# One-time Super Admin Bootstrap Secret (Disable or remove after initial setup)
BOOTSTRAP_ADMIN_SECRET=replace-with-temporary-one-time-bootstrap-secret

# Authentication & Session Policies
AUTH_INVITATION_EXPIRY_HOURS=24
AUTH_SESSION_MAX_AGE_HOURS=8
AUTH_SESSION_IDLE_MINUTES=30
AUTH_EMAIL_FROM=auth@mobiletyrechampions.com

# Application URL
APP_URL=http://localhost:3000

# Strapi to CRM Inbound Webhook Integration
STRAPI_CRM_WEBHOOK_SECRET=replace-with-a-secure-random-32-char-hmac-secret

# Transactional Email Service (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here
EMAIL_FROM="Mobile Tyre Champions <info@mobiletyrechampions.com>"
EMAIL_ADMIN_TO=admin@mobiletyrechampions.com

# Real-Time Pub/Sub Provider (Ably - Optional, built-in SSE stream active by default)
ABLY_API_KEY=

# Environment Mode
NODE_ENV=development
